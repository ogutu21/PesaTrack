rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- shared validation ----------
    function validTx(data, txId) {
      return data.keys().hasOnly(['id', 'description', 'amount', 'type', 'category', 'date',
                                  'createdAt', 'note', 'tags', 'orig', 'by'])
        && data.id == txId
        && data.description is string && data.description.size() <= 200
        && data.amount is number && data.amount > 0
        && data.type in ['income', 'expense']
        && data.category is string
        && data.date is string
        && data.get('note', '') is string && data.get('note', '').size() <= 200
        && data.get('tags', []) is list && data.get('tags', []).size() <= 5
        && data.get('orig', {}) is map
        && data.get('by', '') is string && data.get('by', '').size() <= 40;
    }

    function validSetting(docId, data) {
      return data.keys().hasOnly(['limits', 'items', 'base', 'rates', 'updatedAt'])
        && (
          (docId == 'budgets' && data.limits is map)
          || (docId in ['goals', 'recurring', 'categories', 'households']
              && data.items is list && data.items.size() <= 200)
          || (docId == 'currency' && data.base is string && data.base.size() == 3 && data.rates is map)
        );
    }

    // ---------- personal space ----------
    match /users/{userId}/transactions/{txId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && validTx(request.resource.data, txId);
    }

    match /users/{userId}/settings/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && validSetting(docId, request.resource.data);
    }

    // ---------- shared households ----------
    function isMember(hid) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    match /households/{hid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;

      // Create: you become the only member, as owner.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'members', 'inviteSecret', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.inviteSecret is string && request.resource.data.inviteSecret.size() >= 16
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].role == 'owner';

      allow update: if request.auth != null && (
        // The owner manages the household (rename, remove members, new invite code) but cannot hand it over.
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.auth.uid in request.resource.data.members)
        // A member (not the owner) can remove only themselves.
        || (request.auth.uid in resource.data.members
          && resource.data.ownerId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.keys().toSet()
               == resource.data.members.keys().toSet().difference([request.auth.uid].toSet()))
        // Anyone holding the current invite secret can add themselves as a member.
        || (!(request.auth.uid in resource.data.members)
          && request.resource.data.joinSecret == resource.data.inviteSecret
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinSecret'])
          && request.resource.data.members.keys().toSet()
               == resource.data.members.keys().toSet().union([request.auth.uid].toSet())
          && request.resource.data.members[request.auth.uid].role == 'member')
      );

      match /transactions/{txId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validTx(request.resource.data, txId);
      }

      match /settings/{docId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validSetting(docId, request.resource.data);
      }
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
