rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only touch their own transactions.
    match /users/{userId}/transactions/{txId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
             ['id', 'description', 'amount', 'type', 'category', 'date', 'createdAt'])
        && request.resource.data.id == txId
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 200
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.type in ['income', 'expense']
        && request.resource.data.category is string
        && request.resource.data.date is string;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
