rules_version = '2';

// security-hardening-v1
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- shared validation ----------
    function validTx(data, txId) {
      return data.keys().hasOnly(['id', 'description', 'amount', 'type', 'category', 'date',
                                  'createdAt', 'note', 'tags', 'orig', 'by'])
        && data.id == txId
        && data.description is string && data.description.size() <= 200
        && data.amount is number && data.amount > 0 && data.amount < 1000000000000
        && data.type in ['income', 'expense']
        && data.category is string && data.category.size() > 0 && data.category.size() <= 60
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.get('note', '') is string && data.get('note', '').size() <= 200
        && data.get('tags', []) is list && data.get('tags', []).size() <= 5
        && data.get('orig', {}) is map
        && data.get('orig', {}).keys().hasOnly(['currency', 'amount'])
        && data.get('by', '') is string && data.get('by', '').size() <= 40;
    }

    function validSetting(docId, data) {
      return data.keys().hasOnly(['limits', 'items', 'base', 'rates', 'secret', 'map', 'updatedAt'])   // payees-v1
        && (
          (docId == 'budgets' && data.limits is map && data.limits.size() <= 100)
          || (docId in ['goals', 'recurring', 'categories', 'households']
              && data.items is list && data.items.size() <= 200)
          || (docId == 'ingest' && data.secret is string && data.secret.size() >= 32 && data.secret.size() <= 64)
          || (docId == 'payees' && data.map is map && data.map.size() <= 200)
          || (docId == 'currency' && data.base is string && data.base.size() == 3
              && data.rates is map && data.rates.size() <= 50)
        );
    }

    // ---------- personal space ----------
    match /users/{userId}/transactions/{txId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && validTx(request.resource.data, txId);
    }

    match /users/{userId}/settings/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && validSetting(docId, request.resource.data);
    }

    // inbox-v1: your phone's automation app drops M-Pesa SMS text here. Only you can read or delete it.
    // Creating a message needs your private key (stored in your settings, readable only by you); no edits.
    match /users/{userId}/inbox/{msgId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.resource.data.keys().hasOnly(['text', 'secret'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 20 && request.resource.data.text.size() <= 1000
        && request.resource.data.secret is string
        && exists(/databases/$(database)/documents/users/$(userId)/settings/ingest)
        && request.resource.data.secret == get(/databases/$(database)/documents/users/$(userId)/settings/ingest).data.secret;
      allow update: if false;
    }

    // savings-v1: balances held in your own M-Shwari / KCB M-PESA, read from your M-Pesa messages. Only you can read or write them.
    match /users/{userId}/savings/{acct} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && acct in ['mshwari', 'kcb', 'fuliza']
        && request.resource.data.keys().hasOnly(['balance', 'asOf', 'lastAmount', 'lastDir', 'lastDate', 'due', 'limit', 'updatedAt'])
        && request.resource.data.balance is number && request.resource.data.balance >= 0 && request.resource.data.balance < 1000000000000
        && request.resource.data.lastAmount is number && request.resource.data.lastAmount >= 0 && request.resource.data.lastAmount < 1000000000000
        && request.resource.data.lastDir in ['in', 'out']
        && request.resource.data.asOf is string && request.resource.data.asOf.size() <= 16
        && request.resource.data.lastDate is string && request.resource.data.lastDate.size() <= 10
        && request.resource.data.get('due', '') is string && request.resource.data.get('due', '').size() <= 10
        && request.resource.data.get('limit', 0) is number && request.resource.data.get('limit', 0) < 1000000000000
        && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40;
    }

    // ---------- shared households ----------
    function isMember(hid) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    match /households/{hid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;

      // Create: you become the only member, as owner.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'members', 'inviteSecret', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.inviteSecret is string && request.resource.data.inviteSecret.size() >= 16
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].role == 'owner';

      allow update: if request.auth != null && (
        // The owner manages the household (remove members, new invite code) but cannot hand it over,
        // and cannot store anything other than the known fields.
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.auth.uid in request.resource.data.members
          && request.resource.data.keys().hasOnly(['name', 'ownerId', 'members', 'inviteSecret', 'createdAt', 'joinSecret'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
          && request.resource.data.inviteSecret is string && request.resource.data.inviteSecret.size() >= 16)
        // A member (not the owner) can remove only themselves.
        || (request.auth.uid in resource.data.members
          && resource.data.ownerId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.keys().toSet()
               == resource.data.members.keys().toSet().difference([request.auth.uid].toSet()))
        // Anyone holding the current invite secret can add themselves as a member.
        || (!(request.auth.uid in resource.data.members)
          && request.resource.data.joinSecret == resource.data.inviteSecret
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinSecret'])
          && request.resource.data.members.keys().toSet()
               == resource.data.members.keys().toSet().union([request.auth.uid].toSet())
          && request.resource.data.members[request.auth.uid].role == 'member')
      );

      match /transactions/{txId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validTx(request.resource.data, txId);
      }

      match /settings/{docId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validSetting(docId, request.resource.data);
      }
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
